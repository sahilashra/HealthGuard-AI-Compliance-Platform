# Google Cloud Platform Settings
GCP_PROJECT_ID="your-gcp-project-id"
GCP_PROJECT_NUMBER="your-gcp-project-number"
GCP_REGION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="path/to/your/service-account-key.json"
GCP_SERVICE_ACCOUNT_KEY_PATH="path/to/your/service-account-key.json"

# Gemini AI API
GEMINI_API_KEY="your-gemini-api-key"

# Day 1: Document AI & GCS Configuration
PROCESSOR_DISPLAY_NAME="Healthcare_QA_Processor"
PROCESSOR_TYPE="FORM_PARSER_PROCESSOR"
BUCKET_PREFIX="healthcare-qa-hackathon"
SAMPLE_DOC_PATH="sample_docs/sample_healthcare_requirements.pdf"

# Day 2: Vertex AI Search Configuration
DATA_STORE_DISPLAY_NAME="Healthcare_Compliance_Data_Store"
ENGINE_DISPLAY_NAME="Healthcare_Compliance_Engine"

# Cloud Task Handler URL
JIRA_BATCH_PROCESSOR_URL="https://your-cloud-run-url.run.app/process-jira-batch"

# Jira Integration (Optional)
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@example.com"
JIRA_API_TOKEN="your-jira-api-token"
JIRA_PROJECT_KEY="YOUR_PROJECT_KEY"